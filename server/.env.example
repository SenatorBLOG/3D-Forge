# copy to server/.env and fill in — .env is gitignored, never commit it
PORT=3001
MONGODB_URI=
# leave empty (or set to "mock") to use the built-in mock generator — the full
# pipeline works without Meshy credits; set a real key for actual generation
MESHY_API_KEY=
# cost guard: max real (credit-spending) generations per day. Mock is unlimited.
# Counter resets daily and on server restart. Raise it (or restart) to do more.
MESHY_DAILY_LIMIT=15
# second generation engine (engine:"tripo") — leave empty for its built-in mock
TRIPO_API_KEY=
TRIPO_DAILY_LIMIT=10
# leave empty (or "mock") for the built-in SVG placeholder generator; set a
# Google Gemini key (free at aistudio.google.com) for real text→image
GEMINI_API_KEY=
# quota guard: max real image generations per day (free-tier protection)
IMAGE_DAILY_LIMIT=40
# optional — enables Claude refinement of spatial prompts (deterministic
# template is used without it); CLAUDE_MODEL overrides the default model
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# secret used to sign auth tokens (JWT) — set a long random string in production
JWT_SECRET=
# dev file persistence: without MONGODB_URI, in-memory data is snapshotted to
# server/.devdata/store.json so it survives restarts. Set DEV_PERSIST=0 to opt
# out (CI / a clean slate). Ignored when Mongo is connected or under tests.
DEV_PERSIST=

# --- File storage (Cloudflare R2, S3-compatible) ---------------------------
# Big file bytes (GLBs, images) live in R2 instead of Atlas/GridFS, so the DB
# is not the storage bottleneck and teammates share the same files. R2 free
# tier = 10 GB + zero egress. Set FILES_STORAGE=r2 and fill the R2_* values
# from the Cloudflare dashboard (R2 → Manage API Tokens → Object Read & Write).
# FILES_STORAGE options: r2 | cloud (GridFS) | local (disk, dev only)
FILES_STORAGE=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=3dforge
